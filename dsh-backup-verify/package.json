{
  "name": "dsh-backup-verify",
  "version": "0.1.0",
  "type": "module",
  "description": "Restore a .zip or directory into a temp dir, compare every file sha256, sample-open office and sqlite archives.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "watch.js",
    "cordis.patch.yml",
    "engine",
    "locale",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.2-rc.3 <0.3.0-0",
      "dshReleases": {
        "0.2.2-rc.3": "compatible"
      }
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0-0"
  },
  "author": "eeandyguo",
  "repository": {
    "type": "git",
    "url": "https://github.com/eeandyguo/dsh-evidence-plugins",
    "directory": "dsh-backup-verify"
  }
}
